--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -20,5 +20,6 @@
 # ---------------------------------------------------------------------------------------------------------------------
 # Toolchain: CUDA devel (nvcc 13.3, g++ 13 as nvcc's host compiler) plus git/curl/cmake/nasm and Zig.
-FROM nvidia/cuda:${CUDA_VERSION}-devel-${UBUNTU} AS toolchain
+# Reuse the CUDA 13.0 image already present on both benchmark hosts.
+FROM vllm/vllm-openai:v0.33.0@sha256:d825baf9ce4b1b6bfc5ecc7b79880c7e6748c65a72d697ce3d47607aafa84c6e AS toolchain
 ARG ZIG_VERSION=0.17.0
 ARG ZIG_SHA256
@@ -29,5 +30,5 @@
 # libibverbs-dev is not linked (roce.zig dlopens libibverbs), but its presence keeps a verbs-aware build option honest.
 RUN apt-get update \
- && apt-get install -y --no-install-recommends ca-certificates curl git xz-utils cmake nasm libibverbs-dev \
+ && apt-get install -y --no-install-recommends ca-certificates curl git xz-utils cmake nasm libibverbs-dev g++ make \
  && rm -rf /var/lib/apt/lists/*
 RUN test -n "${ZIG_SHA256}" || { echo "ZIG_SHA256 build arg is required" >&2; exit 1; } \
@@ -122,5 +123,5 @@
     test "$(cat .zig-version)" = "${ZIG_VERSION}" \
       || { echo "TensorFold needs Zig $(cat .zig-version), ZIG_VERSION=${ZIG_VERSION}" >&2; exit 1; } \
- && steps="native grammar" && if [[ "${TOOLS}" == 1 ]]; then steps="install ${steps}"; fi \
+ && steps="native grammar glm-wide-contract" && if [[ "${TOOLS}" == 1 ]]; then steps="install ${steps}"; fi \
  && start=${SECONDS} \
  && zig build ${steps} --prefix "${PREFIX}" --summary failures \
@@ -191,5 +192,7 @@
 # rdma-core adds libibverbs plus the mlx5 provider, which the engine's RoCE all-gather dlopens; without them (or
 # without --device /dev/infiniband) every gather simply stays on NCCL.
-FROM nvidia/cuda:${CUDA_VERSION}-runtime-${UBUNTU} AS runtime
+FROM vllm/vllm-openai:v0.33.0@sha256:d825baf9ce4b1b6bfc5ecc7b79880c7e6748c65a72d697ce3d47607aafa84c6e AS runtime
+ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/dist-packages/nvidia/cu13/lib:/usr/local/lib/python3.12/dist-packages/nvidia/nccl/lib:/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64
+RUN ln -s /usr/local/lib/python3.12/dist-packages/nvidia/nccl/lib/libnccl.so.2 /usr/lib/aarch64-linux-gnu/libnccl.so.2
 SHELL ["/bin/bash", "-o", "pipefail", "-c"]
 ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8
