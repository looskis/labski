+float dot(const float* a, const float* b, int n) {
+    // Match the four eight-lane accumulators and reduction order of the AVX2 path.
+    float lanes[4][8] = {};
+    int i = 0;
+    for (; i + 32 <= n; i += 32) {
+        for (int group = 0; group < 4; ++group)
+            for (int lane = 0; lane < 8; ++lane) {
+                const int pos = i + group*8 + lane;
+                lanes[group][lane] = std::fma(a[pos], b[pos], lanes[group][lane]);
+            }
+    }
+    float l[8];
+    for (int lane = 0; lane < 8; ++lane)
+        l[lane] = (lanes[0][lane] + lanes[1][lane]) + (lanes[2][lane] + lanes[3][lane]);
+    float s = ((l[0] + l[1]) + (l[2] + l[3])) + ((l[4] + l[5]) + (l[6] + l[7]));
+    for (; i < n; ++i) s += a[i] * b[i];
+    return s;
+}
+
+void rms_rows(const float* x, const float* w, int rows, int D, float eps, float* y) {
+    for (int r = 0; r < rows; ++r) {
+        const size_t start = (size_t)r * D;
+        const float k = 1.0f / std::sqrt(dot(x + start, x + start, D) / (float)D + eps);
+        for (int i = 0; i < D; ++i) y[start+i] = (x[start+i] * k) * w[i];
+    }
+}
+
+void sum_into(float* h, const float* const* p, int np, const float* extra, size_t n) {
+    for (size_t i = 0; i < n; ++i) {
+        float sum = p[0][i];
+        for (int j = 1; j < np; ++j) sum += p[j][i];
+        if (extra) sum += extra[i];
+        h[i] += sum;
+    }
+}
+#endif
