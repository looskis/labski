{
  "purpose": "Test the 102 GB FP4-Local checkpoint on one Spark at the same 8K context and four-slot target as the measured pair.",
  "model": "nvidia/Qwen3.8-Flash-Next-FP4-Local",
  "revision": "b9ce18a6887e18c089fdea8509a33e63429a3300",
  "precision": "ModelOpt mixed FP4-Local, FP8 KV, four-token native MTP",
  "nodes": [
    1
  ],
  "per_node_gb": 128,
  "image": "b12x-20261015",
  "prepare_image": "vllm-0.33.0",
  "context": 8192,
  "sequences": 4,
  "memory_fraction": 0.8,
  "container_memory_gib": 112,
  "seccomp_profile": "runtime/spark-io-uring.json",
  "options": {
    "--language-model-only": true,
    "--mamba-cache-mode": "align",
    "--enable-prefix-caching": true,
    "--enable-chunked-prefill": true,
    "--dtype": "bfloat16",
    "--kv-cache-dtype": "fp8",
    "--quantization": "modelopt_mixed",
    "--block-size": 16,
    "--load-format": "b12x",
    "--max-num-batched-tokens": 2048,
    "--speculative-config": {
      "method": "mtp",
      "num_speculative_tokens": 4
    },
    "--gdn-decode-kernel": "b12x",
    "--linear-backend": "b12x",
    "--moe-backend": "b12x",
    "--no-enable-flashinfer-autotune": true,
    "--reasoning-parser": "qwen3",
    "--compilation-config": {
      "pass_config": {
        "fuse_act_quant": true
      }
    }
  },
  "env": {
    "VLLM_PLE_TABLE_MEMORY": "disk",
    "B12X_DISK_BACKEND": "io_uring",
    "CUTE_DSL_ARCH": "sm_121a",
    "SAFETENSORS_FAST_GPU": "1",
    "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
    "VLLM_SSM_CONV_STATE_LAYOUT": "DS",
    "VLLM_USE_AOT_COMPILE": "1",
    "VLLM_USE_MEGA_AOT_ARTIFACT": "1",
    "VLLM_USE_V2_MODEL_RUNNER": "1",
    "B12X_POLICY_MODE": "auto",
    "VLLM_MXFP8_LM_HEAD": "1",
    "VLLM_B12X_MOE_FP4_LAYER_MAX_INPUT_SCALE": "w13",
    "VLLM_B12X_MOE_FP4_FORCE_A16": "1",
    "B12X_W4A16_A4_PREFILL": "1"
  },
  "source": "https://github.com/NVIDIA/local-ai-inference-recipes/tree/bb515086841e7a81e7d51925561338e7dee35023/models/qwen/qwen3.8-flash-next/dgx-spark/linux/vllm/fp4-local"
}
